{
  "buildCommand": "corepack pnpm@10.34.3 run build",
  "outputDirectory": "dist",
  "installCommand": "corepack pnpm@10.34.3 install --frozen-lockfile",
  "framework": null,
  "cleanUrls": true,
  "rewrites": [
    { "source": "/static", "destination": "/" },
    { "source": "/static/(.*)", "destination": "/$1" }
  ]
}
